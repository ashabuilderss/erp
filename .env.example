# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dashboard

# Database URL (used by API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dashboard?schema=public

# Auth
AUTH_SECRET=your-auth-secret-change-in-production
AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=your-encryption-key-change-in-production

# Frontend
FRONTEND_URL=http://localhost:3000
# Server-side URL used by the Next.js auth and proxy routes.
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password

# SMTP (email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ashabuilders.com

# FCM (push notifications)
FCM_SERVER_KEY=
FCM_CREDENTIALS_PATH=

# Sentry (optional — leave blank to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Google Sheets Export (optional — leave blank to disable)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Seed Credentials
SEED_ADMIN_EMAIL=admin@acmerealestate.com
SEED_ADMIN_PASSWORD=SomeSecurePassword@123

