generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ActivityLog {
  id            String    @id @default(cuid())
  action        String
  entityType    String
  entityId      String
  description   String?
  performedById String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  companyId     String
  actorEmail    String?
  actorName     String?
  actorRole     String?
  ipAddress     String?
  requestId     String?
  beforeValues  Json?
  afterValues   Json?
  companies     Company   @relation(fields: [companyId], references: [id])
  employees     Employee? @relation(fields: [performedById], references: [id])
  deletedAt     DateTime?

  @@index([companyId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([performedById])
  @@map("activity_logs")
}

model ApprovalHistory {
  id               String          @id @default(cuid())
  requestId        String
  stepId           String?
  actorId          String?
  action           String
  comments         String?
  createdAt        DateTime        @default(now())
  companyId        String
  employees        Employee?       @relation(fields: [actorId], references: [id])
  approvalRequests ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approvalSteps    ApprovalStep?   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  companies        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedAt        DateTime?

  @@index([requestId])
  @@index([stepId])
  @@index([companyId])
  @@map("approval_histories")
}

model ApprovalRequest {
  id                    String                @id @default(cuid())
  companyId             String
  entityType            String
  entityId              String
  createdById           String
  status                ApprovalStatus        @default(PENDING)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  approvalHistories     ApprovalHistory[]
  companies             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users                 User                  @relation(fields: [createdById], references: [id])
  approvalSteps         ApprovalStep[]
  payrollHolds          PayrollHold?
  taskExtensions        TaskExtension?
  warnings              Warning?
  attendanceCorrections AttendanceCorrection?
  deletedAt             DateTime?

  @@index([companyId])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

model ApprovalStep {
  id                String            @id @default(cuid())
  requestId         String
  sequence          Int
  requiredRoleId    String?
  requiredUserId    String?
  isDirectManager   Boolean           @default(false)
  status            ApprovalStatus    @default(PENDING)
  slaDeadline       DateTime
  escalationLevel   Int               @default(0)
  companyId         String
  approvalHistories ApprovalHistory[]
  approvalRequests  ApprovalRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  roles             Role?             @relation(fields: [requiredRoleId], references: [id])
  users             User?             @relation(fields: [requiredUserId], references: [id])
  companies         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedAt         DateTime?

  @@index([requestId])
  @@index([companyId])
  @@map("approval_steps")
}

model ApprovalTemplateStep {
  id                String           @id @default(cuid())
  templateId        String
  sequence          Int
  requiredRoleId    String?
  requiredUserId    String?
  isDirectManager   Boolean          @default(false)
  slaHours          Int              @default(24)
  companyId         String
  roles             Role?            @relation(fields: [requiredRoleId], references: [id])
  users             User?            @relation(fields: [requiredUserId], references: [id])
  approvalTemplates ApprovalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  companies         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedAt         DateTime?

  @@index([companyId])
  @@map("approval_template_steps")
}

model ApprovalTemplate {
  id                    String                 @id @default(cuid())
  companyId             String
  entityType            String
  description           String?
  createdAt             DateTime               @default(now())
  approvalTemplateSteps ApprovalTemplateStep[]
  companies             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedAt             DateTime?

  @@unique([companyId, entityType])
  @@map("approval_templates")
}

model AttendanceAnomaly {
  id                                                  String                  @id @default(cuid())
  employeeId                                          String
  companyId                                           String
  attendanceSessionId                                 String?
  attendanceDayAggregateId                            String?
  attendanceCorrectionId                              String?
  anomalyType                                         AnomalyType
  severity                                            AnomalySeverity         @default(MEDIUM)
  detectedBy                                          String
  detectedAt                                          DateTime                @default(now())
  resolved                                            Boolean                 @default(false)
  resolvedById                                        String?
  resolvedAt                                          DateTime?
  remarks                                             String?
  attendanceCorrections                               AttendanceCorrection?   @relation(fields: [attendanceCorrectionId], references: [id])
  attendanceDayAggregates                             AttendanceDayAggregate? @relation(fields: [attendanceDayAggregateId], references: [id])
  attendanceSessions                                  AttendanceSession?      @relation(fields: [attendanceSessionId], references: [id])
  companies                                           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeesAttendanceAnomaliesEmployeeIdToemployees   Employee                @relation("attendance_anomalies_employeeIdToemployees", fields: [employeeId], references: [id], onDelete: Cascade)
  employeesAttendanceAnomaliesResolvedByIdToemployees Employee?               @relation("attendance_anomalies_resolvedByIdToemployees", fields: [resolvedById], references: [id])
  deletedAt                                           DateTime?

  @@index([companyId])
  @@index([employeeId])
  @@index([resolved])
  @@map("attendance_anomalies")
}

model AttendanceCorrection {
  id                      String                  @id @default(cuid())
  employeeId              String
  companyId               String
  reason                  String
  requestedCheckIn        String?
  requestedCheckOut       String?
  requestedStatus         String?
  createdAt               DateTime                @default(now())
  approvalRequestId       String?                 @unique
  approvalRequests        ApprovalRequest?        @relation(fields: [approvalRequestId], references: [id])
  dayAggregateId          String?
  attendanceAnomalies     AttendanceAnomaly[]
  companies               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendanceDayAggregates AttendanceDayAggregate? @relation(fields: [dayAggregateId], references: [id])
  employees               Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceEvidence      AttendanceEvidence[]
  deletedAt               DateTime?

  @@index([companyId])
  @@index([employeeId])
  @@map("attendance_corrections")
}

model AttendanceDayAggregate {
  id                    String                 @id @default(cuid())
  employeeId            String
  companyId             String
  date                  DateTime               @db.Date
  totalWorkMinutes      Int                    @default(0)
  totalBreakMinutes     Int                    @default(0)
  firstPunchAt          DateTime?
  lastPunchAt           DateTime?
  status                DayAggregateStatus     @default(COMPLETED)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  attendanceAnomalies   AttendanceAnomaly[]
  attendanceCorrections AttendanceCorrection[]
  companies             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees             Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceSessions    AttendanceSession[]
  deletedAt             DateTime?

  @@unique([companyId, employeeId, date])
  @@index([companyId])
  @@index([date])
  @@index([employeeId])
  @@map("attendance_day_aggregates")
}

model AttendanceEvidence {
  id                    String                @id @default(cuid())
  companyId             String
  punchId               String?
  correctionId          String?
  type                  EvidenceType
  storageObjectId       String
  geofenceVersionId     String?
  gpsAccuracy           Decimal?              @db.Decimal(10, 2)
  mockLocationDetected  Boolean               @default(false)
  developerModeActive   Boolean               @default(false)
  locationProvider      String?
  movementSpeed         Decimal?              @db.Decimal(10, 2)
  createdAt             DateTime              @default(now())
  companies             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendanceCorrections AttendanceCorrection? @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  geofenceVersions      GeofenceVersion?      @relation(fields: [geofenceVersionId], references: [id])
  attendancePunches     AttendancePunch?      @relation(fields: [punchId], references: [id], onDelete: Cascade)
  storageObjects        StorageObject         @relation(fields: [storageObjectId], references: [id])
  deletedAt             DateTime?

  @@index([companyId])
  @@index([correctionId])
  @@index([punchId])
  @@map("attendance_evidence")
}

model AttendanceEvidenceReview {
  id            String                @id @default(cuid())
  companyId     String
  evidenceId    String
  punchId       String?
  reviewedById  String
  status        EvidenceReviewStatus  @default(PENDING)
  remarks       String?
  reviewedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([companyId])
  @@index([evidenceId])
  @@index([punchId])
  @@index([reviewedById])
  @@index([status])
  @@map("attendance_evidence_reviews")
}

model AttendanceFinalizationBatch {
  id                         String                      @id @default(cuid())
  companyId                  String
  attendancePeriodId         String
  policyVersionId            String
  holidayCalendarVersionId   String
  status                     BatchStatus                 @default(PROCESSING)
  startedAt                  DateTime                    @default(now())
  completedAt                DateTime?
  processedCount             Int                         @default(0)
  failedCount                Int                         @default(0)
  finalizedById              String
  attendancePeriods          AttendancePeriod            @relation(fields: [attendancePeriodId], references: [id])
  companies                  Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users                      User                        @relation(fields: [finalizedById], references: [id])
  holidayCalendarVersions    HolidayCalendarVersion      @relation(fields: [holidayCalendarVersionId], references: [id])
  attendancePolicyVersions   AttendancePolicyVersion     @relation(fields: [policyVersionId], references: [id])
  attendanceSummaries        AttendanceSummary[]
  payrollAttendanceSnapshots PayrollAttendanceSnapshot[]
  deletedAt                  DateTime?

  @@index([attendancePeriodId])
  @@index([companyId])
  @@map("attendance_finalization_batches")
}

model AttendanceHistory {
  id             String    @id @default(cuid())
  companyId      String
  targetType     String
  targetId       String
  actorId        String?
  transitionType String
  previousState  String?
  newState       String?
  reason         String?
  createdAt      DateTime  @default(now())
  employees      Employee? @relation(fields: [actorId], references: [id])
  companies      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedAt      DateTime?

  @@index([companyId])
  @@index([targetType, targetId])
  @@map("attendance_histories")
}

model AttendancePeriod {
  id                            String                        @id @default(cuid())
  companyId                     String
  startDate                     DateTime                      @db.Date
  endDate                       DateTime                      @db.Date
  status                        AttendancePeriodStatus        @default(OPEN)
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  attendanceFinalizationBatches AttendanceFinalizationBatch[]
  companies                     Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendanceSummaries           AttendanceSummary[]
  payrollAttendanceSnapshots    PayrollAttendanceSnapshot[]
  deletedAt                     DateTime?

  @@unique([companyId, startDate, endDate])
  @@index([companyId])
  @@index([status])
  @@map("attendance_periods")
}

model AttendancePolicyVersion {
  id                            String                        @id @default(cuid())
  companyId                     String
  versionNumber                 Int
  effectiveFrom                 DateTime
  effectiveTo                   DateTime?
  policyConfiguration           Json
  createdById                   String
  createdAt                     DateTime                      @default(now())
  attendanceFinalizationBatches AttendanceFinalizationBatch[]
  companies                     Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users                         User                          @relation(fields: [createdById], references: [id])
  attendanceSummaries           AttendanceSummary[]
  payrollAttendanceSnapshots    PayrollAttendanceSnapshot[]
  deletedAt                     DateTime?

  @@index([companyId])
  @@map("attendance_policy_versions")
}

model AttendancePunch {
  id                  String               @id @default(cuid())
  employeeId          String
  companyId           String
  timestamp           DateTime
  punchType           PunchType
  deviceId            String?
  locationId          String?
  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
   clientGeneratedUuid String?              @unique @map("clientGeneratedUUID")
   payloadHash         String?
   locationMismatch    Boolean              @default(false)
   createdAt           DateTime             @default(now())
  attendanceEvidence  AttendanceEvidence[]
  companies           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees           Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deletedAt           DateTime?

  @@index([companyId])
  @@index([employeeId])
  @@index([timestamp])
  @@map("attendance_punches")
}

model AttendanceSession {
  id                        String                   @id @default(cuid())
  employeeId                String
  companyId                 String
  dayAggregateId            String
  shiftAssignmentSnapshotId String?
  sessionStart              DateTime
  sessionEnd                DateTime?
  totalWorkedMinutes        Int                      @default(0)
  totalBreakMinutes         Int                      @default(0)
  overtimeMinutes           Int                      @default(0)
  firstPunchId              String?
  lastPunchId               String?
  sessionStatus             SessionStatus            @default(ACTIVE)
  attendanceAnomalies       AttendanceAnomaly[]
  companies                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendanceDayAggregates   AttendanceDayAggregate   @relation(fields: [dayAggregateId], references: [id], onDelete: Cascade)
  employees                 Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftAssignmentSnapshots  ShiftAssignmentSnapshot? @relation(fields: [shiftAssignmentSnapshotId], references: [id])
  deletedAt                 DateTime?

  @@index([companyId])
  @@index([dayAggregateId])
  @@index([employeeId])
  @@map("attendance_sessions")
}

model AttendanceSummary {
  id                            String                      @id @default(cuid())
  companyId                     String
  employeeId                    String
  attendancePeriodId            String
  policyVersionId               String
  attendanceFinalizationBatchId String
  payableMinutes                Int                         @default(0)
  overtimeMinutes               Int                         @default(0)
  lateMinutes                   Int                         @default(0)
  absentDays                    Int                         @default(0)
  leaveDays                     Int                         @default(0)
  projectionVersion             Int                         @default(1)
  lastProcessedEventId          String?
  lastProcessedCorrelationId    String?
  rebuiltAt                     DateTime?
  lastProjectionUpdate          DateTime                    @default(now())
  attendanceFinalizationBatches AttendanceFinalizationBatch @relation(fields: [attendanceFinalizationBatchId], references: [id])
  attendancePeriods             AttendancePeriod            @relation(fields: [attendancePeriodId], references: [id])
  companies                     Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees                     Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendancePolicyVersions      AttendancePolicyVersion     @relation(fields: [policyVersionId], references: [id])
  deletedAt                     DateTime?

  @@unique([companyId, employeeId, attendancePeriodId])
  @@index([attendancePeriodId])
  @@index([companyId])
  @@map("attendance_summaries")
}

model DashboardMetricsSnapshot {
  id                         String    @id @default(cuid())
  companyId                  String
  snapshotDate               DateTime  @db.Date
  totalEmployees             Int       @default(0)
  presentEmployees           Int       @default(0)
  absentEmployees            Int       @default(0)
  lateEmployees              Int       @default(0)
  activeWarnings             Int       @default(0)
  activePayrollHolds         Int       @default(0)
  pendingApprovals           Int       @default(0)
  overdueTasks               Int       @default(0)
  projectionVersion          Int       @default(1)
  lastProcessedEventId       String?
  lastProcessedCorrelationId String?
  rebuiltAt                  DateTime?
  lastProjectionUpdate       DateTime  @default(now())
  companies                  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedAt                  DateTime?

  @@unique([companyId, snapshotDate])
  @@index([companyId])
  @@index([snapshotDate])
  @@map("dashboard_metrics_snapshots")
}

model Booking {
  id                   String               @id @default(cuid())
  propertyId           String
  customerId           String
  leadId               String?
  bookingDate          DateTime
  amount               Decimal              @db.Decimal(14, 2)
  status               BookingStatus        @default(PENDING)
  paymentStatus        PaymentStatus        @default(PENDING)
  notes                String?
  assignedToEmployeeId String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  companyId            String
  employees            Employee             @relation(fields: [assignedToEmployeeId], references: [id])
  companies            Company              @relation(fields: [companyId], references: [id])
  customers            Customer             @relation(fields: [customerId], references: [id])
  leads                Lead?                @relation(fields: [leadId], references: [id])
  properties           Property             @relation(fields: [propertyId], references: [id])
  paymentEntries       PaymentEntry[]
  paymentSchedules     PaymentSchedule[]
  pipelineCommissions  PipelineCommission[]
  deletedAt            DateTime?

  @@index([assignedToEmployeeId])
  @@index([companyId])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([propertyId])
  @@index([status])
  @@map("bookings")
}

model Broker {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  companyName    String?
  phone          String?
  email          String?
  commissionRate Decimal?  @db.Decimal(5, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  companies Company @relation(fields: [companyId], references: [id])
  leads     Lead[]  @relation("BrokerLeads")

  @@unique([companyId, email])
  @@index([companyId])
  @@map("brokers")
}

model Company {
  id                            String                        @id @default(cuid())
  name                          String
  slug                          String                        @unique
  isActive                      Boolean                       @default(true)
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  deletedAt                     DateTime?
  settings                      Json?
  gstin                         String?
  pan                           String?
  activityLogs                  ActivityLog[]
  approvalRequests              ApprovalRequest[]
  approvalTemplates             ApprovalTemplate[]
  attendanceAnomalies           AttendanceAnomaly[]
  attendanceCorrections         AttendanceCorrection[]
  attendanceDayAggregates       AttendanceDayAggregate[]
  attendanceEvidence            AttendanceEvidence[]
  attendanceFinalizationBatches AttendanceFinalizationBatch[]
  attendanceHistories           AttendanceHistory[]
  attendancePeriods             AttendancePeriod[]
  attendancePolicyVersions      AttendancePolicyVersion[]
  attendancePunches             AttendancePunch[]
  attendanceSessions            AttendanceSession[]
  attendanceSummaries           AttendanceSummary[]
  bookings                      Booking[]
  brokers                       Broker[]
  complaints                    Complaint[]
  constructionSites             ConstructionSite[]
  customers                     Customer[]
  dashboardMetricsSnapshots     DashboardMetricsSnapshot[]
  delegations                   Delegation[]
  departments                   Department[]
  designations                  Designation[]
  deviceRegistrations           DeviceRegistration[]
  employeeAssignments           EmployeeAssignment[]
  employeeShiftAssignments      EmployeeShiftAssignment[]
  employees                     Employee[]
  eodReports                    EodReport[]
  escalationEvents              EscalationEvent[]
  escalationRules               EscalationRule[]
  expenseClaims                 ExpenseClaim[]
  geofenceVersions              GeofenceVersion[]
  holidayCalendarVersions       HolidayCalendarVersion[]
  incentives                    Incentive[]
  inventoryItems                InventoryItem[]
  labourEntries                 LabourEntry[]
  leads                         Lead[]
  leadFollowUps                 LeadFollowUp[]
  leaveAllocations              LeaveAllocation[]
  leaveRequests                 LeaveRequest[]
  materialConsumption           MaterialConsumption[]
  materialInward                MaterialInward[]
  materials                     Material[]
  notifications                 Notification[]
  paymentEntries                PaymentEntry[]
  paymentSchedules              PaymentSchedule[]
  payrollAttendanceSnapshots    PayrollAttendanceSnapshot[]
  payrollHolds                  PayrollHold[]
  payrollRuns                   PayrollRun[]
  payslips                      Payslip[]
  performance                   Performance[]
  permissionGrants              PermissionGrant[]
  pipelineCommissions           PipelineCommission[]
  progressPhotos                ProgressPhoto[]
  properties                    Property[]
  refreshTokens                 RefreshToken[]
  reportExports                 ReportExport[]
  rolePermissions               RolePermission[]
  roles                         Role[]
  securityEvents                SecurityEvent[]
  shiftAssignmentSnapshots      ShiftAssignmentSnapshot[]
  shiftDefinitions              ShiftDefinition[]
  sitePhases                    SitePhase[]
  siteVisits                    SiteVisit[]
  storageObjects                StorageObject[]
  taskComments                  TaskComment[]
  taskTemplates                 TaskTemplate[]
  tasks                         Task[]
  teams                         Team[]
  tempTokens                    TempToken[]
  userPermissions               UserPermission[]
  users                         User[]
  vendors                       Vendor[]
  warnings                      Warning[]
  performanceScores             PerformanceScore[]
  managerRatings                ManagerRating[]
  performanceTrendSnapshots     PerformanceTrendSnapshot[]
  dashboardKpiSnapshots         DashboardKpiSnapshot[]
  dashboardAlerts               DashboardAlert[]
  exportConfigs                 ExportConfig[]
  exportLogs                    ExportLog[]
  downloadLogs                  DownloadLog[]
  auditRecords                  AuditRecord[]
  deletionLogs                  DeletionLog[]
  announcements                 Announcement[]
  announcementReceipts          AnnouncementReceipt[]
  documentRegistries            DocumentRegistry[]
  documentAccessLogs            DocumentAccessLog[]
  quotations                    Quotation[]
  quotationAccessLogs           QuotationAccessLog[]
  officeLocations               OfficeLocation[]
  agreements                    Agreement[]
  projectBudgets                ProjectBudget[]
  jobPostings                   JobPosting[]
  sopDocuments                  SopDocument[]
  assets                        Asset[]
  meetings                      Meeting[]
  workOrders                    WorkOrder[]
  projectCostEntries            ProjectCostEntry[]
  candidates                    Candidate[]
  interviews                    Interview[]
  sopAcknowledgements           SopAcknowledgement[]
  trainingRecords               TrainingRecord[]
  assetAssignments              AssetAssignment[]
  assetRepairs                  AssetRepair[]
  meetingAttendees              MeetingAttendee[]
  meetingMinutes                MeetingMinutes[]
  meetingActionItems            MeetingActionItem[]
  paymentReferences             PaymentReference[]
  inventorySnapshots            InventorySnapshot[]
  approvalHistories             ApprovalHistory[]
  approvalSteps                 ApprovalStep[]
  approvalTemplateSteps         ApprovalTemplateStep[]
  domainEvents                  DomainEvent[]
  payrollHoldHistories          PayrollHoldHistory[]
  recurringSchedules            RecurringSchedule[]
  taskExtensions                TaskExtension[]
  taskHistories                 TaskHistory[]
  taskProofs                    TaskProof[]
  taskCompletionApprovals       TaskCompletionApproval[]
  warningHistories              WarningHistory[]
  agreementApprovals            AgreementApproval[]
  inventoryTransactions         InventoryTransaction[]
  warningAcknowledgements       WarningAcknowledgement[]

  @@map("companies")
}

model OfficeLocation {
  id        String    @id @default(cuid())
  companyId String
  name      String
  ipAddress String?
  latitude  Decimal?  @db.Decimal(10, 8)
  longitude Decimal?  @db.Decimal(11, 8)
  radius    Int?      @default(50)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companies Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedAt DateTime?

  @@index([companyId])
  @@map("office_locations")
}

model Complaint {
  id          String          @id @default(cuid())
  companyId   String
  customerId  String
  propertyId  String?
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  companies   Company         @relation(fields: [companyId], references: [id])
  customers   Customer        @relation(fields: [customerId], references: [id])
  properties  Property?       @relation(fields: [propertyId], references: [id])
  deletedAt   DateTime?

  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@map("complaints")
}

model ConstructionSite {
  id               String                 @id @default(cuid())
  companyId        String
  name             String
  location         String
  status           SiteStatus             @default(PLANNING)
  startDate        DateTime?              @db.Date
  endDate          DateTime?              @db.Date
  budget           Decimal?               @db.Decimal(14, 2)
  description      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  companies        Company                @relation(fields: [companyId], references: [id])
  inventoryItems   InventoryItem[]
  labourEntries    LabourEntry[]
  materialConsumption MaterialConsumption[]
  materialInward   MaterialInward[]
  progressPhotos   ProgressPhoto[]
  sitePhases       SitePhase[]
  projectBudget    ProjectBudget?
  transactionsFrom InventoryTransaction[] @relation("SiteFrom")
  transactionsTo   InventoryTransaction[] @relation("SiteTo")
  deletedAt        DateTime?

  @@index([companyId])
  @@index([status])
  @@map("construction_sites")
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
