  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  company   Company             @relation(fields: [companyId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  approvals AgreementApproval[]

  @@map("agreements")
}

model AgreementApproval {
  id          String   @id @default(cuid())
  agreementId String
  approverId  String
  step        Int
  status      String
  comments    String?
  timestamp   DateTime @default(now())
  companyId   String

  agreement Agreement @relation(fields: [agreementId], references: [id])
  approver  User      @relation(fields: [approverId], references: [id])
  companies Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("agreement_approvals")
}

// 5.2 Project Profitability

model ProjectBudget {
  id           String   @id @default(cuid())
  siteId       String   @unique
  companyId    String
  budgetAmount Float
  actualAmount Float    @default(0)
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site        ConstructionSite   @relation(fields: [siteId], references: [id])
  company     Company            @relation(fields: [companyId], references: [id])
  costEntries ProjectCostEntry[]

  @@map("project_budgets")
}

model ProjectCostEntry {
  id          String   @id @default(cuid())
  companyId   String
  budgetId    String
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())

  budget  ProjectBudget @relation(fields: [budgetId], references: [id])
  company Company       @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("project_cost_entries")
}

// 5.3 Recruitment Pipeline

enum JobPostingStatus {
  OPEN
  CLOSED
  ON_HOLD
}

enum CandidateStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
}

model JobPosting {
  id           String           @id @default(cuid())
  companyId    String
  title        String
  departmentId String
  description  String
  status       JobPostingStatus @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  department Department  @relation(fields: [departmentId], references: [id])
  candidates Candidate[]

  @@map("job_postings")
}

model Candidate {
  id           String          @id @default(cuid())
  companyId    String
  jobPostingId String
  name         String
  email        String
  phone        String?
  resumeUrl    String?
  status       CandidateStatus @default(APPLIED)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  jobPosting JobPosting  @relation(fields: [jobPostingId], references: [id])
  interviews Interview[]
  company    Company     @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("candidates")
}

model Interview {
  id            String   @id @default(cuid())
  companyId     String
  candidateId   String
  interviewerId String
  scheduledAt   DateTime
  feedback      String?
  rating        Int?
  createdAt     DateTime @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id])
  interviewer User      @relation(fields: [interviewerId], references: [id])
  company     Company   @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("interviews")
}

// 5.4 Training & SOP Library

model SopDocument {
  id           String   @id @default(cuid())
  companyId    String
  title        String
  content      String?
  fileUrl      String?
  version      String   @default("1.0")
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company          Company              @relation(fields: [companyId], references: [id])
  department       Department?          @relation(fields: [departmentId], references: [id])
  acknowledgements SopAcknowledgement[]
  trainingRecords  TrainingRecord[]

  @@map("sop_documents")
}

model SopAcknowledgement {
  id             String   @id @default(cuid())
  companyId      String
  sopDocumentId  String
  employeeId     String
  acknowledgedAt DateTime @default(now())

  company     Company     @relation(fields: [companyId], references: [id])
  sopDocument SopDocument @relation(fields: [sopDocumentId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  @@index([companyId])
  @@map("sop_acknowledgements")
}

model TrainingRecord {
  id            String   @id @default(cuid())
  companyId     String
  employeeId    String
  sopDocumentId String
  completedAt   DateTime @default(now())
  score         Int?

  company     Company     @relation(fields: [companyId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])
  sopDocument SopDocument @relation(fields: [sopDocumentId], references: [id])

  @@index([companyId])
  @@map("training_records")
}

// 5.5 Asset Management

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
}

model Asset {
  id                String      @id @default(cuid())
  companyId         String
  name              String
  category          String
  serialNumber      String?
  qrCode            String?
  status            AssetStatus @default(AVAILABLE)
  currentAssigneeId String?
  purchaseDate      DateTime?
  purchaseCost      Float?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  company         Company           @relation(fields: [companyId], references: [id])
  currentAssignee Employee?         @relation(fields: [currentAssigneeId], references: [id])
  assignments     AssetAssignment[]
  repairs         AssetRepair[]

  @@map("assets")
}

model AssetAssignment {
  id         String    @id @default(cuid())
  companyId  String
  assetId    String
  employeeId String
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  condition  String?

  company  Company  @relation(fields: [companyId], references: [id])
  asset    Asset    @relation(fields: [assetId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId])
  @@map("asset_assignments")
}

model AssetRepair {
  id          String    @id @default(cuid())
  companyId   String
  assetId     String
  description String
  cost        Float?
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      String

  company Company @relation(fields: [companyId], references: [id])
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([companyId])
  @@map("asset_repairs")
}

// 5.6 Meeting Management

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Meeting {
  id          String        @id @default(cuid())
  companyId   String
  title       String
  scheduledAt DateTime
  location    String?
  status      MeetingStatus @default(SCHEDULED)
  organizerId String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  company     Company             @relation(fields: [companyId], references: [id])
  organizer   User                @relation(fields: [organizerId], references: [id])
  attendees   MeetingAttendee[]
  minutes     MeetingMinutes[]
  actionItems MeetingActionItem[]

  @@map("meetings")
}

model MeetingAttendee {
  id         String  @id @default(cuid())
  companyId  String
  meetingId  String
  employeeId String
  attended   Boolean @default(false)

  company  Company  @relation(fields: [companyId], references: [id])
  meeting  Meeting  @relation(fields: [meetingId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId])
  @@map("meeting_attendees")
}

model MeetingMinutes {
  id           String   @id @default(cuid())
  companyId    String
  meetingId    String
  content      String
  recordedById String
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id])
  meeting    Meeting @relation(fields: [meetingId], references: [id])
  recordedBy User    @relation(fields: [recordedById], references: [id])

  @@index([companyId])
  @@map("meeting_minutes")
}

model MeetingActionItem {
  id          String    @id @default(cuid())
  companyId   String
  meetingId   String
  description String
  assigneeId  String
  dueDate     DateTime?
  taskId      String?   @unique

  company  Company  @relation(fields: [companyId], references: [id])
  meeting  Meeting  @relation(fields: [meetingId], references: [id])
  assignee Employee @relation(fields: [assigneeId], references: [id])
  task     Task?    @relation(fields: [taskId], references: [id])

  @@index([companyId])
  @@map("meeting_action_items")
}

// -----------------------------------------
// PHASE 6 - PARTIAL MODULE COMPLETIONS
// -----------------------------------------

model WorkOrder {
  id          String    @id @default(cuid())
  vendorId    String
  companyId   String
  title       String
  description String?
  amount      Float
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  vendor      Vendor             @relation(fields: [vendorId], references: [id])
  company     Company            @relation(fields: [companyId], references: [id])
  paymentRefs PaymentReference[]

  @@map("work_orders")
}

model PaymentReference {
  id              String   @id @default(cuid())
  companyId       String
  workOrderId     String
  amount          Float
  referenceNumber String
  date            DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([companyId])
  @@map("payment_references")
}

enum InventoryTransactionType {
  INWARD
  OUTWARD
  WASTAGE
  TRANSFER
}

model InventoryTransaction {
  id           String                   @id @default(cuid())
  itemId       String
  type         InventoryTransactionType
  quantity     Float
  siteFromId   String?
  siteToId     String?
  date         DateTime                 @default(now())
  recordedById String
  companyId    String

  item       InventoryItem     @relation(fields: [itemId], references: [id])
  siteFrom   ConstructionSite? @relation("SiteFrom", fields: [siteFromId], references: [id])
  siteTo     ConstructionSite? @relation("SiteTo", fields: [siteToId], references: [id])
  recordedBy User              @relation(fields: [recordedById], references: [id])
  companies  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("inventory_transactions")
}

model InventorySnapshot {
  id        String   @id @default(cuid())
  companyId String
  itemId    String
  date      DateTime @default(now())
  quantity  Float

  company Company       @relation(fields: [companyId], references: [id])
  item    InventoryItem @relation(fields: [itemId], references: [id])

  @@index([companyId])
  @@map("inventory_snapshots")
}

model LeadFollowUp {
  id               String       @id @default(cuid())
  leadId           String
  companyId        String
  followUpType     FollowUpType
  followUpDate     DateTime     @default(now())
  outcome          String?
  nextFollowUpDate DateTime?
  notes            String?
  recordedById     String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  lead       Lead     @relation(fields: [leadId], references: [id])
  company    Company  @relation(fields: [companyId], references: [id])
  recordedBy Employee @relation(fields: [recordedById], references: [id])

  @@index([leadId])
  @@index([companyId])
  @@index([followUpDate])
  @@index([nextFollowUpDate])
  @@map("lead_follow_ups")
}
