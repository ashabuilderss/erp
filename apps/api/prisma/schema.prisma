generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
  VILLA
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  SITE_VISIT_SCHEDULED
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  PHONE_INQUIRY
  WALK_IN
  OTHER
}

enum CustomerType {
  BUYER
  SELLER
  BOTH
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
}

enum PaymentMethod {
  CASH
  CHEQUE
  ONLINE
  BANK_TRANSFER
}

enum ScheduleStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EodReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum EscalationTriggerType {
  LEAD_STALE
  ATTENDANCE_MISSED
  LEAVE_PENDING
  APPROVAL_PENDING
  TASK_OVERDUE
}

enum EscalationEventStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  COMPLETED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  APPROVED
  PAID
}

enum SiteStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum SitePhaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum LabourType {
  SKILLED
  UNSKILLED
  SUPERVISOR
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  OTHER
  MEDICAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum EmployeeStaffType {
  OFFICE
  FIELD
  HYBRID
}

enum AssignmentType {
  PROPERTY
  LEAD
  SITE_VISIT
  BOOKING
}

model Company {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  isActive  Boolean        @default(true)
  settings  Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  users               User[]
  departments         Department[]
  designations        Designation[]
  employees           Employee[]
  properties          Property[]
  leads               Lead[]
  customers           Customer[]
  siteVisits          SiteVisit[]
  bookings            Booking[]
  attendances         Attendance[]
  leaveRequests       LeaveRequest[]
  leaveAllocations    LeaveAllocation[]
  employeeAssignments EmployeeAssignment[]
  performances        Performance[]
  refreshTokens       RefreshToken[]
  tempTokens          TempToken[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  paymentSchedules    PaymentSchedule[]
  paymentEntries      PaymentEntry[]
  expenseClaims       ExpenseClaim[]
  eodReports          EodReport[]
  escalationRules     EscalationRule[]
  escalationEvents    EscalationEvent[]
  taskComments        TaskComment[]
  deviceRegistrations DeviceRegistration[]
  attendanceCorrections AttendanceCorrection[]
  payrollRuns         PayrollRun[]
  payslips            Payslip[]
  constructionSites   ConstructionSite[]
  vendors             Vendor[]
  materials           Material[]
  materialInward      MaterialInward[]
  inventoryItems      InventoryItem[]
  labourEntries       LabourEntry[]
  progressPhotos      ProgressPhoto[]
  brokers             Broker[]
  dealers             Dealer[]
  complaints          Complaint[]
  reportExports       ReportExport[]
  permissionGrants    PermissionGrant[]

  @@map("companies")
}

model User {
  id              String   @id @default(cuid())
  email           String
  companyId       String
  firstName       String
  lastName        String
  hashedPassword  String?
  avatarUrl       String?
  role            UserRole @default(EMPLOYEE)
  isActive        Boolean  @default(true)
  notificationPreferences Json?
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpVerifiedAt  DateTime?
  backupCodes     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  company       Company        @relation(fields: [companyId], references: [id])
  employee         Employee?
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  tempTokens             TempToken[]
  permissionGrants       PermissionGrant[] @relation("UserGrants")
  grantedPermissionGrants PermissionGrant[] @relation("GrantedBy")

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  companyId   String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  company      Company       @relation(fields: [companyId], references: [id])
  designations Designation[]
  employees    Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model Designation {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  companyId    String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id])
  employees  Employee[]

  @@unique([companyId, name, departmentId])
  @@index([companyId])
  @@index([departmentId])
  @@map("designations")
}

model Employee {
  id            String         @id @default(cuid())
  userId        String?        @unique
  employeeCode  String
  companyId     String
  departmentId  String
  designationId String
  managerId     String?
  phone         String?
  dateOfJoining     DateTime?
  salary            Decimal?       @db.Decimal(12, 2)
  address           String?
  status            EmployeeStatus     @default(ACTIVE)
  staffType         EmployeeStaffType? @default(OFFICE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  company      Company     @relation(fields: [companyId], references: [id])
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  department   Department  @relation(fields: [departmentId], references: [id])
  designation  Designation @relation(fields: [designationId], references: [id])
  manager      Employee?   @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates Employee[]  @relation("EmployeeManager")

  attendance         Attendance[]        @relation("EmployeeAttendance")
  verifiedAttendance Attendance[]        @relation("AttendanceVerifier")
  leaveRequests      LeaveRequest[]       @relation("EmployeeLeaveRequests")
  leaveAllocations   LeaveAllocation[]
  assignedProperties Property[]           @relation("PropertyAssignment")
  assignedLeads      Lead[]               @relation("LeadAssignment")
  assignedSiteVisits SiteVisit[]          @relation("SiteVisitAssignment")
  assignedBookings   Booking[]            @relation("BookingAssignment")
  createdCustomers   Customer[]
  approvedLeaves     LeaveRequest[]       @relation("LeaveApprover")
  activityLogs       ActivityLog[]
  assignments         EmployeeAssignment[]
  performance         Performance[]
  recordedPayments    PaymentEntry[]       @relation("PaymentRecorder")
  expenseClaims       ExpenseClaim[]
  approvedExpenseClaims ExpenseClaim[]     @relation("ExpenseApprover")
  eodReports            EodReport[]        @relation("EmployeeEod")
  reviewedEodReports    EodReport[]        @relation("EodReviewer")
  taskComments          TaskComment[]
  deviceRegistrations   DeviceRegistration[]
  attendanceCorrections AttendanceCorrection[]
  approvedCorrections   AttendanceCorrection[] @relation("CorrectionApprover")
  payrollRuns           PayrollRun[]            @relation("PayrollProcessor")
  payslips              Payslip[]
  reportExports         ReportExport[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([departmentId])
  @@index([designationId])
  @@index([managerId])
  @@index([status])
  @@map("employees")
}

model Attendance {
  id            String           @id @default(cuid())
  employeeId    String
  companyId     String
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus @default(PRESENT)
  verified      Boolean          @default(false)
  verifiedById  String?
  verifiedAt    DateTime?
  latitude      Decimal?         @db.Decimal(10, 7)
  longitude     Decimal?         @db.Decimal(10, 7)
  checkInPhoto  String?
  checkOutPhoto String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employee   Employee  @relation("EmployeeAttendance", fields: [employeeId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id])
  verifiedBy Employee? @relation("AttendanceVerifier", fields: [verifiedById], references: [id])

  @@unique([companyId, employeeId, date])
  @@index([companyId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendance")
}

model DeviceRegistration {
  id         String   @id @default(cuid())
  employeeId String
  companyId  String
  deviceName String
  deviceId   String
  fcmToken   String? @map("fcmtoken")
  isTrusted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, employeeId, deviceId])
  @@index([companyId])
  @@index([employeeId])
  @@map("device_registrations")
}

model AttendanceCorrection {
  id                String           @id @default(cuid())
  employeeId        String
  companyId         String
  attendanceId      String?
  date              DateTime         @db.Date
  reason            String
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  requestedStatus   AttendanceStatus?
  status            CorrectionStatus @default(PENDING)
  approvedById      String?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id])
  approvedBy Employee? @relation("CorrectionApprover", fields: [approvedById], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@map("attendance_corrections")
}

model PayrollRun {
  id              String           @id @default(cuid())
  companyId       String
  periodStart     DateTime         @db.Date
  periodEnd       DateTime         @db.Date
  status          PayrollRunStatus @default(DRAFT)
  totalEarnings   Decimal?         @db.Decimal(14, 2)
  totalDeductions Decimal?         @db.Decimal(14, 2)
  totalNetPay     Decimal?         @db.Decimal(14, 2)
  employeeCount   Int?
  processedById   String?
  processedAt     DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company    Company   @relation(fields: [companyId], references: [id])
  processedBy Employee? @relation("PayrollProcessor", fields: [processedById], references: [id])
  payslips   Payslip[]

  @@unique([companyId, periodStart, periodEnd])
  @@index([companyId])
  @@index([status])
  @@map("payroll_runs")
}

model Payslip {
  id              String        @id @default(cuid())
  payrollRunId    String
  employeeId      String
  companyId       String
  basicSalary     Decimal       @db.Decimal(12, 2)
  earnings        Json
  deductions      Json
  grossPay        Decimal       @db.Decimal(14, 2)
  totalDeductions Decimal       @db.Decimal(14, 2)
  netPay          Decimal       @db.Decimal(14, 2)
  status          PayslipStatus @default(DRAFT)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee   Employee   @relation(fields: [employeeId], references: [id])
  company    Company    @relation(fields: [companyId], references: [id])
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([companyId, payrollRunId, employeeId])
  @@index([companyId])
  @@index([employeeId])
  @@index([payrollRunId])
  @@map("payslips")
}

model ConstructionSite {
  id          String     @id @default(cuid())
  companyId   String
  name        String
  location    String
  status      SiteStatus @default(PLANNING)
  startDate   DateTime?  @db.Date
  endDate     DateTime?  @db.Date
  budget      Decimal?   @db.Decimal(14, 2)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company        Company          @relation(fields: [companyId], references: [id])
  phases         SitePhase[]
  materialInward MaterialInward[]
  inventory      InventoryItem[]
  labourEntries  LabourEntry[]
  progressPhotos ProgressPhoto[]

  @@index([companyId])
  @@index([status])
  @@map("construction_sites")
}

model SitePhase {
  id              String          @id @default(cuid())
  siteId          String
  name            String
  description     String?
  startDate       DateTime?       @db.Date
  endDate         DateTime?       @db.Date
  status          SitePhaseStatus @default(PENDING)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  site           ConstructionSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  progressPhotos ProgressPhoto[]

  @@index([siteId])
  @@map("site_phases")
}

model Vendor {
  id             String       @id @default(cuid())
  companyId      String
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  gstin          String?
  status         VendorStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  materialInward MaterialInward[]

  @@index([companyId])
  @@index([status])
  @@map("vendors")
}

model Material {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  category    String
  unit        String
  unitPrice   Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company          @relation(fields: [companyId], references: [id])
  materialInward MaterialInward[]
  inventoryItems InventoryItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([category])
  @@map("materials")
}

model MaterialInward {
  id           String   @id @default(cuid())
  companyId    String
  vendorId     String
  siteId       String
  materialId   String
  quantity     Decimal  @db.Decimal(12, 2)
  unitPrice    Decimal  @db.Decimal(12, 2)
  totalAmount  Decimal  @db.Decimal(14, 2)
  receivedDate DateTime @db.Date
  notes        String?
  invoiceUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id])
  vendor   Vendor           @relation(fields: [vendorId], references: [id])
  site     ConstructionSite @relation(fields: [siteId], references: [id])
  material Material          @relation(fields: [materialId], references: [id])

  @@index([companyId])
  @@index([vendorId])
  @@index([siteId])
  @@index([materialId])
  @@index([receivedDate])
  @@map("material_inward")
}

model InventoryItem {
  id             String   @id @default(cuid())
  companyId      String
  siteId         String
  materialId     String
  quantityOnHand Decimal  @db.Decimal(12, 2)
  lastUpdated    DateTime @default(now()) @updatedAt

  company  Company          @relation(fields: [companyId], references: [id])
  site     ConstructionSite @relation(fields: [siteId], references: [id])
  material Material          @relation(fields: [materialId], references: [id])

  @@unique([companyId, siteId, materialId])
  @@index([companyId])
  @@index([siteId])
  @@index([materialId])
  @@map("inventory_items")
}

model LabourEntry {
  id          String     @id @default(cuid())
  companyId   String
  siteId      String
  labourName  String
  labourType  LabourType @default(UNSKILLED)
  date        DateTime   @db.Date
  hoursWorked Decimal?   @db.Decimal(5, 1)
  wagesAmount Decimal    @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company Company          @relation(fields: [companyId], references: [id])
  site    ConstructionSite @relation(fields: [siteId], references: [id])

  @@index([companyId])
  @@index([siteId])
  @@index([date])
  @@map("labour_entries")
}

model ProgressPhoto {
  id          String   @id @default(cuid())
  companyId   String
  siteId      String
  phaseId     String?
  photoUrl    String
  caption     String?
  takenAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id])
  site    ConstructionSite @relation(fields: [siteId], references: [id])
  phase   SitePhase?       @relation(fields: [phaseId], references: [id])

  @@index([companyId])
  @@index([siteId])
  @@index([phaseId])
  @@index([takenAt])
  @@map("progress_photos")
}

model Broker {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  companyName    String?
  phone          String?
  email          String?
  commissionRate Decimal? @db.Decimal(5, 2)
  passwordHash   String?
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brokerCompany Company @relation(fields: [companyId], references: [id])
  leads         Lead[]  @relation("BrokerLeads")

  @@unique([companyId, email])
  @@index([companyId])
  @@map("brokers")
}

model Dealer {
  id           String   @id @default(cuid())
  companyId    String
  companyName  String
  contactPerson String?
  phone        String?
  email        String?
  gstin        String?
  address      String?
  passwordHash String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, email])
  @@index([companyId])
  @@map("dealers")
}

model Complaint {
  id          String           @id @default(cuid())
  companyId   String
  customerId  String
  propertyId  String?
  subject     String
  description String
  status      ComplaintStatus  @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@map("complaints")
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  companyId    String
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  type         LeaveType   @default(OTHER)
  reason       String?
  documentUrl  String?
  status       LeaveStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee   Employee  @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy Employee? @relation("LeaveApprover", fields: [approvedById], references: [id])
  company    Company   @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model LeaveAllocation {
  id         String    @id @default(cuid())
  employeeId String
  companyId  String
  year       Int
  leaveType  LeaveType
  totalDays  Int       @default(0)
  usedDays   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id])

  @@unique([employeeId, companyId, year, leaveType])
  @@index([employeeId, year])
  @@index([companyId])
  @@map("leave_allocations")
}

model Property {
  id                   String         @id @default(cuid())
  propertyCode         String?
  title                String
  description          String?
  type                 PropertyType   @default(APARTMENT)
  status               PropertyStatus @default(AVAILABLE)
  price                Decimal        @db.Decimal(14, 2)
  area                 Decimal?       @db.Decimal(10, 2)
  bedrooms             Int?
  bathrooms            Int?
  location             String
  locality             String?
  city                 String
  state                String
  images               Json?
  amenities            Json?
  companyId            String
  assignedToEmployeeId String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  company    Company     @relation(fields: [companyId], references: [id])
  assignedTo Employee?   @relation("PropertyAssignment", fields: [assignedToEmployeeId], references: [id])
  leads      Lead[]
  siteVisits SiteVisit[]
  bookings   Booking[]
  complaints Complaint[]

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@index([city])
  @@index([assignedToEmployeeId])
  @@unique([companyId, propertyCode])
  @@index([companyId, status])
  @@map("properties")
}

model Lead {
  id                    String     @id @default(cuid())
  propertyId            String?
  customerName          String
  customerEmail         String?
  customerPhone         String?
  source                LeadSource @default(OTHER)
  status                LeadStatus @default(NEW)
  notes                 String?
  companyId             String
  assignedToEmployeeId  String?
  brokerId              String?
  convertedToCustomerId String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  company             Company     @relation(fields: [companyId], references: [id])
  property            Property?   @relation(fields: [propertyId], references: [id])
  assignedTo          Employee?   @relation("LeadAssignment", fields: [assignedToEmployeeId], references: [id])
  convertedToCustomer Customer?   @relation(fields: [convertedToCustomerId], references: [id])
  broker              Broker?     @relation("BrokerLeads", fields: [brokerId], references: [id])
  siteVisits          SiteVisit[]
  bookings            Booking[]

  @@index([companyId])
  @@index([status])
  @@index([source])
  @@index([assignedToEmployeeId])
  @@index([propertyId])
  @@map("leads")
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  type        CustomerType @default(BUYER)
  source      String?
  notes       String?
  companyId   String
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  company    Company     @relation(fields: [companyId], references: [id])
  createdBy  Employee?   @relation(fields: [createdById], references: [id])
  leads      Lead[]
  siteVisits SiteVisit[]
  bookings   Booking[]
  complaints Complaint[]

  @@index([companyId])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

model SiteVisit {
  id                   String          @id @default(cuid())
  propertyId           String
  customerId           String
  leadId               String?
  companyId            String
  scheduledDate        DateTime
  status               SiteVisitStatus @default(SCHEDULED)
  notes                String?
  feedback             String?
  assignedToEmployeeId String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  company    Company  @relation(fields: [companyId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  lead       Lead?    @relation(fields: [leadId], references: [id])
  assignedTo Employee @relation("SiteVisitAssignment", fields: [assignedToEmployeeId], references: [id])

  @@index([companyId])
  @@index([propertyId])
  @@index([customerId])
  @@index([assignedToEmployeeId])
  @@index([status])
  @@index([scheduledDate])
  @@map("site_visits")
}

model Booking {
  id                   String        @id @default(cuid())
  propertyId           String
  customerId           String
  leadId               String?
  companyId            String
  bookingDate          DateTime
  amount               Decimal       @db.Decimal(14, 2)
  status               BookingStatus @default(PENDING)
  paymentStatus        PaymentStatus @default(PENDING)
  notes                String?
  assignedToEmployeeId String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company    Company  @relation(fields: [companyId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  lead       Lead?    @relation(fields: [leadId], references: [id])
  assignedTo Employee @relation("BookingAssignment", fields: [assignedToEmployeeId], references: [id])
  paymentSchedules PaymentSchedule[]
  paymentEntries   PaymentEntry[]

  @@index([companyId])
  @@index([propertyId])
  @@index([customerId])
  @@index([assignedToEmployeeId])
  @@index([status])
  @@index([paymentStatus])
  @@map("bookings")
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model PipelineCommission {
  id          String           @id @default(cuid())
  companyId   String
  leadId      String?
  bookingId   String?
  employeeId  String
  amount      Decimal          @db.Decimal(14, 2)
  percentage  Decimal?         @db.Decimal(5, 2)
  status      CommissionStatus @default(PENDING)
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([leadId])
  @@index([bookingId])
  @@map("pipeline_commissions")
}

enum IncentiveStatus {
  ACTIVE
  CLOSED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
}

model Incentive {
  id              String          @id @default(cuid())
  companyId       String
  title           String
  description     String
  award           String
  value           Decimal?        @db.Decimal(14, 2)
  opportunityLabel String?
  opportunityType String?
  status          IncentiveStatus @default(ACTIVE)
  payoutStatus    PayoutStatus    @default(PENDING)
  winnerId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("incentives")
}

model PaymentSchedule {
  id                 String         @id @default(cuid())
  bookingId          String
  companyId          String
  installmentNumber  Int
  amount             Decimal        @db.Decimal(14, 2)
  dueDate            DateTime       @db.Date
  paidDate           DateTime?
  status             ScheduleStatus @default(PENDING)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  company Company  @relation(fields: [companyId], references: [id])

  @@unique([bookingId, installmentNumber])
  @@index([companyId])
  @@index([bookingId])
  @@index([status])
  @@index([dueDate])
  @@map("payment_schedules")
}

model PaymentEntry {
  id             String        @id @default(cuid())
  bookingId      String
  companyId      String
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?
  paymentDate    DateTime      @db.Date
  notes          String?
  recordedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id])
  recordedBy Employee? @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([companyId])
  @@index([bookingId])
  @@index([paymentDate])
  @@map("payment_entries")
}

model ExpenseClaim {
  id          String        @id @default(cuid())
  employeeId  String
  companyId   String
  amount      Decimal       @db.Decimal(14, 2)
  category    String
  description String?
  status      ExpenseStatus @default(PENDING)
  receiptUrl  String?
  expenseDate  DateTime      @db.Date
  approvedById String?
  approvedAt   DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employee   Employee  @relation(fields: [employeeId], references: [id])
  company    Company   @relation(fields: [companyId], references: [id])
  approvedBy Employee? @relation("ExpenseApprover", fields: [approvedById], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([expenseDate])
  @@map("expense_claims")
}

model ActivityLog {
  id            String   @id @default(cuid())
  action        String
  entityType    String
  entityId      String
  description   String?
  companyId     String
  performedById String?
  actorEmail    String?
  actorName     String?
  actorRole     String?
  ipAddress     String?
  requestId     String?
  beforeValues  Json?
  afterValues   Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  company     Company   @relation(fields: [companyId], references: [id])
  performedBy Employee? @relation(fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([companyId])
  @@index([performedById])
  @@map("activity_logs")
}

model SecurityEvent {
  id            String   @id @default(cuid())
  eventType     String
  severity      String   @default("info")
  description   String?
  ipAddress     String?
  userAgent     String?
  userId        String?
  companyId     String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
  @@map("security_events")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  companyId String
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy String?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([token])
  @@index([companyId])
  @@map("refresh_tokens")
}

model TempToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  companyId String
  purpose   String   @default("2FA_CHALLENGE")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("temp_tokens")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId, read])
  @@index([companyId])
  @@map("notifications")
}

model EmployeeAssignment {
  id         String         @id @default(cuid())
  employeeId String
  companyId  String
  type       AssignmentType
  entityId   String
  startDate  DateTime?
  endDate    DateTime?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  company     Company        @relation(fields: [companyId], references: [id])
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taskComments TaskComment[]

  @@index([employeeId, type])
  @@index([companyId])
  @@index([entityId])
  @@map("employee_assignments")
}

model Performance {
  id         String   @id @default(cuid())
  employeeId String
  companyId  String
  year       Int
  quarter    Int
  score      Int      @db.SmallInt
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, year, quarter])
  @@index([companyId])
  @@index([employeeId])
  @@index([year, quarter])
  @@map("performance")
}

model EodReport {
  id              String         @id @default(cuid())
  employeeId      String
  companyId       String
  reportDate      DateTime       @db.Date
  accomplishments String         @db.Text
  challenges      String?
  tomorrowPlan    String?
  status          EodReportStatus @default(DRAFT)
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  employee   Employee  @relation("EmployeeEod", fields: [employeeId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id])
  reviewedBy Employee? @relation("EodReviewer", fields: [reviewedById], references: [id])

  @@unique([employeeId, companyId, reportDate])
  @@index([companyId])
  @@index([employeeId])
  @@index([reportDate])
  @@index([status])
  @@map("eod_reports")
}

model EscalationRule {
  id          String               @id @default(cuid())
  companyId   String
  name        String
  triggerType EscalationTriggerType
  config      Json
  level       Int                  @default(1)
  notifyRoles String[]
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  company Company        @relation(fields: [companyId], references: [id])
  events  EscalationEvent[]

  @@index([companyId])
  @@index([triggerType])
  @@map("escalation_rules")
}

model EscalationEvent {
  id              String                @id @default(cuid())
  ruleId          String
  companyId       String
  entityType      String
  entityId        String
  triggeredAt     DateTime              @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  status          EscalationEventStatus @default(TRIGGERED)
  notes           String?

  rule    EscalationRule @relation(fields: [ruleId], references: [id])
  company Company        @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([ruleId])
  @@index([entityType, entityId])
  @@index([status])
  @@map("escalation_events")
}

model TaskComment {
  id           String   @id @default(cuid())
  assignmentId String
  companyId    String
  authorId     String
  content      String   @db.Text
  isPrivate    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment EmployeeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  company    Company            @relation(fields: [companyId], references: [id])
  author     Employee           @relation(fields: [authorId], references: [id])

  @@index([assignmentId])
  @@index([companyId])
  @@index([authorId])
  @@map("task_comments")
}

model ReportExport {
  id            String   @id @default(cuid())
  companyId     String
  reportKey     String
  title         String
  format        String   @default("CSV")
  status        String   @default("PENDING")
  filters       Json?
  fileUrl       String?
  fileSize      Int?
  generatedById String?
  generatedAt   DateTime?
  failedAt      DateTime?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company   @relation(fields: [companyId], references: [id])
  generatedBy Employee? @relation(fields: [generatedById], references: [id])

  @@index([companyId])
  @@index([reportKey])
  @@index([status])
  @@index([createdAt])
  @@map("report_exports")
}

model PermissionGrant {
  id         String   @id @default(cuid())
  userId     String
  permission String
  granted    Boolean  @default(true)
  companyId  String
  grantedById String?
  createdAt  DateTime @default(now())

  user      User   @relation("UserGrants", fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id])
  grantedBy User?  @relation("GrantedBy", fields: [grantedById], references: [id])

  @@unique([companyId, userId, permission])
  @@index([companyId])
  @@index([userId])
  @@index([permission])
  @@map("permission_grants")
}
