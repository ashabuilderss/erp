FROM node:22-alpine AS deps
WORKDIR /app
COPY apps/web/package*.json ./
RUN npm ci --omit=dev

FROM node:22-alpine AS builder
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=4096
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
# Reuse host-built .next (skip slow in-container build). If empty, builds fresh.
COPY apps/web/.next ./.next
COPY apps/web/package*.json ./
COPY apps/web/ ./
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S -G nodejs nextjs && adduser -S -u 1001 nextjs
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/public ./app/public
# Next expects static at the standalone server root's .next/static
COPY --from=builder /app/.next/static ./app/.next/static
RUN chown -R nextjs:nodejs /app
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD wget --no-quiet --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
